        quiver(xy(zk, 1), xy(zk, 2), ...
               dxydt_m(zk, 1), dxydt_m(zk, 2),...
               'Color',quv_cmap_list(k,:));
        hold on
    end
end
hold on

XL = get(gca,'xlim'); XR = XL(2);
YL = get(gca,'ylim'); YT = YL(2);

plot(XL,YT*ones(size(XL)),...
    'color', 'k','linewidth',0.25)
hold on
plot(XR*ones(size(YL)),YL,...
    'color', 'k','linewidth',0.25)
hold on

sel_show_idx = [...%3,9,15,28,29,35,38
    28];

for k = 1:length(sel_show_idx)
    plot(2*x_cell{sel_show_idx(k),1}(1,:),...
        2*x_cell{sel_show_idx(k),1}(2,:),...
        '-','LineWidth',0.25,...
        'Color',0.7*ones(1,3))
    hold on
    scatter(2*x_cell{sel_show_idx(k),1}(1,:),...
        2*x_cell{sel_show_idx(k),1}(2,:),...
        c_mk_size*ones(size(x_cell{sel_show_idx(k),1},2),1),...
        mat2gray(imresize(curve_cmap,...
        [size(x_cell{sel_show_idx(k),1},2),3])))
    hold on
end
hold off

set(gca,'FontSize',6)
set(gca,'TickDir','out')

set(gca,'YTickLabel',[])

box off

xlabel('x_1')

title(dy_title_list{sel_dy_idx})

% colorbar

%% mesostasis analysis comparison



%% L exp
low_op_sort_pca_l_mat = ...
    cellfun(@(x) lyapunovExponent(x(60:(end-60),:)',30),...
    op_lmt_cell(:,1));

low_free_sort_pca_l_mat = ...
    cellfun(@(x) lyapunovExponent(x',30),...
    free_lmt_cell(:,1));

high_op_sort_pca_l_mat = ...
    cellfun(@(x) lyapunovExponent(x(:,16:25)',30),...
    op_lmt_cell(:,1));

high_free_sort_pca_l_mat = ...
    cellfun(@(x) lyapunovExponent(x(:,16:25)',30),...
    free_lmt_cell(:,1));

mean_low_op_sort_pca_l_mat = mean(low_op_sort_pca_l_mat);
mean_low_free_sort_pca_l_mat = mean(low_free_sort_pca_l_mat);
mean_high_op_sort_pca_l_mat = mean(high_op_sort_pca_l_mat);
mean_high_free_sort_pca_l_mat = mean(high_free_sort_pca_l_mat);

cmp_pair_name = {...
    '6tpmpfc';...
    '7tpmpfc';...
    '8tpmpfc';...
    '9tpmpfc';...
    '10tpmpfc';...
    };

cmp_group_name = {...
    'op';...
    'free'};

all_cmp_l = zeros(size(cmp_pair_name,1),...
    size(cmp_group_name,1));

op_splname = split(op_sort_fcf_cell(:,1),'-');
free_splname = split(free_sort_fcf_cell(:,1),'-');

for m = 1:size(all_cmp_l,1)
    op_selidx = strcmp(...
        cmp_pair_name{m},op_splname(:,3));
    free_selidx = strcmp(...
        cmp_pair_name{m},free_splname(:,3));
    
    all_cmp_l(m,1) = mean(op_sort_pca_l_mat(op_selidx,:));
    all_cmp_l(m,2) = mean(free_sort_pca_l_mat(free_selidx,:));
end




























