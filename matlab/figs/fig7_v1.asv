%% compare pose parameters, paired speed
loco_thres = 150;

free_speed = cell(size(free_sort_fcf_cell,1),1);
for k = 1:size(free_sort_fcf_cell,1)
    temppose = free_sort_fcf_cell{k,3};
    for m = 1:size(temppose,2)
        temppose(:,m) = smooth(...
            medfilt1(...
            temppose(:,m),30),30);
    end
    
    temp_speed = zeros(1,(size(temppose,2)/3));
    for m = 1:size(temp_speed,2)
        ttpose = temppose(:,((m-1)*3+1):(m*3));

        tempv = sqrt(sum(diff(ttpose).^2,2))*fs;

        temp_speed(1,m) = mean(tempv(tempv<loco_thres));
    end
    free_speed{k,1} = temp_speed;
end

free_speed = cell2mat(free_speed);

op_speed = cell(size(op_sort_fcf_cell,1),1);
for k = 1:size(op_sort_fcf_cell,1)
    temppose = op_sort_fcf_cell{k,3};
    for m = 1:size(temppose,2)
        temppose(:,m) = smooth(...
            medfilt1(...
            temppose(:,m),30),30);
    end
    
    temp_speed = zeros(1,(size(temppose,2)/3));
    for m = 1:size(temp_speed,2)
        ttpose = temppose(:,((m-1)*3+1):(m*3));

        tempv = sqrt(sum(diff(ttpose).^2,2))*fs;

        temp_speed(1,m) = mean(tempv(tempv<loco_thres));
    end
    op_speed{k,1} = temp_speed;
end

op_speed = cell2mat(op_speed);

op_spl_name = split(op_sort_fcf_cell(:,1),'-');
free_spl_name = split(free_sort_fcf_cell(:,1),'-');

group_name = {...
    '6tpmpfc';...
    '7tpmpfc';...
    '8tpmpfc';...
    '9tpmpfc';...
    '10tpmpfc';...
    };

op_group_data = zeros(size(group_name,1),size(op_speed,2));
free_group_data = zeros(size(group_name,1),size(free_speed,2));

for m = 1:size(group_name,1)
    selop = strcmp(group_name{m,1},op_spl_name(:,3));
    selfree = strcmp(group_name{m,1},free_spl_name(:,3));

    selop_speed = op_speed(selop,:);
    selfree_speed = free_speed(selfree,:);

    op_group_data(m,:) = mean(selop_speed)/10;
    free_group_data(m,:) = mean(selfree_speed)/10;
end

stat_op_group_data = op_group_data';
stat_free_group_data = free_group_data';

mean_op_group_data = mean(op_group_data);
mean_free_group_data = mean(free_group_data);

std_op_group_data = std(op_group_data)./sqrt(size(op_group_data,1));
std_free_group_data = std(free_group_data)./sqrt(size(free_group_data,1));

% stat
p_list = zeros(1,size(op_group_data,2));
for k = 1:size(op_group_data,2)
    opdata = op_group_data(:,k);
    freedata = free_group_data(:,k);

    [h_norm_1,p_norm_1] = lillietest(opdata);
    [h_norm_2,p_norm_2] = lillietest(freedata);

    [h_var,p_var] = vartest2(opdata,freedata);

    sum_h = h_norm_1+h_norm_2+h_var;

    if sum_h==0
        [h,p] = ttest(opdata,freedata);
        disp('ttest')
        disp(p)
    else
        [p,h] = signrank(opdata,freedata);
        disp('signrank')
        disp(p)
    end
    p_list(1,k) = p;
end

show_star_list = {...
    0.05,1,'ns';...
    0.01,0.05,'*';...
    0.001,0.01,'**';...
    0.0001,0.001,'***';...
    0,0.0001,'****';...
    };

show_star_y = cell(size(p_list));
for k = 1:length(p_list)
    tempp = p_list(k);
    for m = 1:size(show_star_list,1)
        if show_star_list{m,1}<=tempp &&...
                tempp<show_star_list{m,2}
            show_star_y{k} = show_star_list{m,3};
        end
    end
end
