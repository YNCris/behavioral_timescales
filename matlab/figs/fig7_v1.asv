%% show pcs
start_x = 0.32;
start_y = 0.64;

box_x = 0.05;
box_y = 0.08;

inter_x = 0.013;
inter_y = 0.02;

show_pca_num = [1,2,3,24,25];

show_bias = 0;

cmap_neu = flipud(cbrewer2('RdBu',1000));

count = 1;
for k = show_pca_num
    %% load data
    sel_op_pc = cellfun(@(x) x(:,k+show_bias),...
        op_lmt_cell(:,1),'UniformOutput',false);
    sel_free_pc = cellfun(@(x) x(:,k+show_bias),...
        free_lmt_cell(:,1),'UniformOutput',false);
    

    pad_free_pc = -1*ones(size(sel_free_pc,1),pad_len);
        
    for m = 1:size(sel_free_pc,1)
        pad_free_pc(m,1:length(sel_free_pc{m})) = sel_free_pc{m};
    end
    
    pad_free_pc(pad_free_pc==-1) = NaN;

    pad_op_pc = -1*ones(size(sel_op_pc,1),pad_len);
        
    for m = 1:size(sel_op_pc,1)
        pad_op_pc(m,1:length(sel_op_pc{m})) = sel_op_pc{m};
    end
    
    pad_op_pc(pad_op_pc==-1) = NaN;

    %% show
    temph = subplot('Position',[...
        start_x+(count-1)*(box_x+inter_x),start_y,...
        box_x,box_y]);
    imagesc(pad_op_pc)
    hold on
    plot(op_self_mov_start_list(:,1),...
        op_self_mov_start_list(:,2),'-k')
    hold on
    plot(op_self_mov_end_list(:,1),...
        op_self_mov_end_list(:,2),'-k')
    hold off

    colormap(temph,[1,1,1;cmap_neu])

    box off

    set(gca,'YTick',[1,size(pad_op_pc,1)])
    if k == 1
        ylabel('Neural PC')
    else
        set(gca,'YTickLabel',[])
    end

    set(gca,'FontSize',6)
    set(gca,'TickDir','out')
    set(gca,'XTick',x_tick)
    set(gca,'XTickLabel',[])

    title(['PC ',num2str(k)])

    temph = subplot('Position',[...
        start_x+(count-1)*(box_x+inter_x),...
        start_y-(box_y+inter_y),...
        box_x,box_y]);
    imagesc(pad_free_pc)
    hold on
    plot(free_self_mov_start_list(:,1),...
        free_self_mov_start_list(:,2),'-k')
    hold on
    plot(free_self_mov_end_list(:,1),...
        free_self_mov_end_list(:,2),'-k')
    hold off

    colormap(temph,[1,1,1;cmap_neu])

    box off
    
    set(gca,'YTick',[1,size(pad_free_pc,1)])
    if k == 1
        ylabel('Neural PC')
    else
        set(gca,'YTickLabel',[])
    end

    set(gca,'FontSize',6)
    set(gca,'TickDir','out')
    set(gca,'XTick',x_tick)
    set(gca,'XTickLabel',x_tick_label)
    set(gca,'XTickLabelRotation',0)

    xlabel('Time (s)')

    count = count+1;
    
end

