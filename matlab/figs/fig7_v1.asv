    start_x+1*box_x+cbar_inter_x,...
    start_y+box_y-cbar_box_y,...
    cbar_box_x,cbar_box_y]);
imagesc(flipud((1:max(unique_seq))'))
colormap(temph,cmap_seq)
set(gca,'XTick',[],'YTick',[])

text(0.5,40,'1','FontSize',6,'VerticalAlignment','middle')
text(0.5,-5,'31','FontSize',6,'VerticalAlignment','middle')

text(3.5,17,{'Sequence','categories'},...
    'FontSize',6,'Rotation',90,...
    'HorizontalAlignment','center')
%% compare behavior differences, all
mov_all = cellfun(@(x) cell2mat(x(:,2)),...
    all_data_cell(:,[4,7]),'UniformOutput',false);

tab_mov_all = cellfun(@(x) tabulate(x),...
    mov_all,'UniformOutput',false);

mov_frac_cell = cell(size(mov_all));
for m = 1:size(mov_frac_cell,1)
    for n = 1:size(mov_frac_cell,2)
        temptab = tab_mov_all{m,n};
        mov_frac = zeros(1,size(unique_mov,1));
        mov_frac(1,temptab(:,1)) = ...
            temptab(:,3)/100;
        mov_frac_cell{m,n} = mov_frac;
    end
end

op_mov_frac_self_all = cell2mat(mov_frac_cell(6:10,1))';
free_mov_frac_self_all = cell2mat(mov_frac_cell(1:5,1))';

op_mov_frac_partner_all = cell2mat(mov_frac_cell(6:10,2))';
free_mov_frac_partner_all = cell2mat(mov_frac_cell(1:5,2))';

self_sign_mov = [8,32];
self_sign_mov_name = unique_mov_name(self_sign_mov);
%% compare behavior differences, mov
free_mov_frac_self = zeros(size(free_sort_fcf_cell,1),...
    size(unique_mov,1));
free_mov_frac_partner = zeros(size(free_sort_fcf_cell,1),...
    size(unique_mov,1));
for k = 1:size(free_sort_fcf_cell,1)
    tempmov_self = cell2mat(...
        free_sort_fcf_cell{k,4}(:,2));
    tab_tempmov_self = tabulate(tempmov_self);
    mov_frac = zeros(1,size(unique_mov,1));
    mov_frac(1,tab_tempmov_self(:,1)) = ...
        tab_tempmov_self(:,3)/100;

    free_mov_frac_self(k,:) = mov_frac;

    tempmov_partner = cell2mat(...
        free_sort_fcf_cell{k,7}(:,2));
    tab_tempmov_partner = tabulate(tempmov_partner);
    mov_frac = zeros(1,size(unique_mov,1));
    mov_frac(1,tab_tempmov_partner(:,1)) = ...
        tab_tempmov_partner(:,3)/100;

    free_mov_frac_partner(k,:) = mov_frac;
end

op_mov_frac_self = zeros(size(op_sort_fcf_cell,1),...
    size(unique_mov,1));
op_mov_frac_partner = zeros(size(op_sort_fcf_cell,1),...
    size(unique_mov,1));
for k = 1:size(op_sort_fcf_cell,1)
    tempmov_self = cell2mat(...
        op_sort_fcf_cell{k,4}(:,2));
    tab_tempmov_self = tabulate(tempmov_self);
    mov_frac = zeros(1,size(unique_mov,1));
    mov_frac(1,tab_tempmov_self(:,1)) = ...
        tab_tempmov_self(:,3)/100;

    op_mov_frac_self(k,:) = mov_frac;

    tempmov_partner = cell2mat(...
        op_sort_fcf_cell{k,7}(:,2));
    tab_tempmov_partner = tabulate(tempmov_partner);
    mov_frac = zeros(1,size(unique_mov,1));
    mov_frac(1,tab_tempmov_partner(:,1)) = ...
        tab_tempmov_partner(:,3)/100;

    op_mov_frac_partner(k,:) = mov_frac;
end

% screen data
free_mov_frac_self_idx = double(free_mov_frac_self>0);
free_mov_frac_partner_idx = double(free_mov_frac_partner>0);
op_mov_frac_self_idx = double(op_mov_frac_self>0);
op_mov_frac_partner_idx = double(op_mov_frac_partner>0);

free_mov_frac_self_idx_sum = sum(free_mov_frac_self_idx);
op_mov_frac_self_idx_sum = sum(op_mov_frac_self_idx);
free_mov_frac_partner_idx_sum = sum(free_mov_frac_partner_idx);
op_mov_frac_partner_idx_sum = sum(op_mov_frac_partner_idx);

sel_thres = 10;

sel_free_mov_self = free_mov_frac_self_idx_sum>=sel_thres;
sel_op_mov_self = op_mov_frac_self_idx_sum>=sel_thres;
sel_mov_self = sel_free_mov_self|sel_op_mov_self;
sel_mov_self_idx = unique([find(sel_mov_self),self_sign_mov]);

sel_free_mov_partner = free_mov_frac_partner_idx_sum>=sel_thres;
sel_op_mov_partner = op_mov_frac_partner_idx_sum>=sel_thres;
sel_mov_partner = sel_free_mov_partner|sel_op_mov_partner;
sel_mov_partner_idx = find(sel_mov_partner);

cmp_op_mov_self = op_mov_frac_self(:,sel_mov_self_idx)';
cmp_free_mov_self = free_mov_frac_self(:,sel_mov_self_idx)';

cmp_op_mov_partner = op_mov_frac_partner(:,sel_mov_partner_idx)';
cmp_free_mov_partner = free_mov_frac_partner(:,sel_mov_partner_idx)';

cmp_op_mov_self_all = op_mov_frac_self_all(sel_mov_self_idx,:);
cmp_free_mov_self_all = free_mov_frac_self_all(sel_mov_self_idx,:);

cmp_op_mov_partner_all = op_mov_frac_partner_all(sel_mov_partner_idx,:);
cmp_free_mov_partner_all = free_mov_frac_partner_all(sel_mov_partner_idx,:);

% final show data, trial x mov
show_op_mov_self = cmp_op_mov_self';
show_free_mov_self = cmp_free_mov_self';

show_op_mov_partner = cmp_op_mov_partner';
show_free_mov_partner = cmp_free_mov_partner';


show_op_mov_self_all = cmp_op_mov_self_all';
show_free_mov_self_all = cmp_free_mov_self_all';

show_op_mov_partner_all = cmp_op_mov_partner_all';
show_free_mov_partner_all = cmp_free_mov_partner_all';

