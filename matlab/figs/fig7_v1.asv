x_list_right = x_list+x_bias;

body_point_name = {...
    'Nose';...
    'Left ear';...
    'Right ear';...
    'Neck';...
    'Left front limb';...
    'Right front limb';...
    'Left hind limb';...
    'Right hind limb';...
    'Left front paw';...
    'Right front paw';...
    'Left hind paw';...
    'Right hind paw';...
    'Back';...
    'Tail base';...
    'Mid tail';...
    'Tip tail';...
    };


