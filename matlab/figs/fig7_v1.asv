%{
    show neural modulation
    far close far
    + close far 
%}
clear all
close all
addpath(genpath(pwd))
rmpath(['D:\SBeA_Analysis\SBeA_v0.0.1\TPM\figs\function\' ...
    'gtw\lib\subspace']);
rmpath(['D:\SBeA_Analysis\SBeA_v0.0.1\TPM\figs\old\function\' ...
    'gtw\lib\subspace']);
rmpath(['D:\SBeA_Analysis\SBeA_v0.0.1\TPM\function\' ...
    'gtw\lib\subspace']);
%% set path
rootpath = ['H:\MTPM_body_language'];

beh_video_path = [rootpath,'\raw_data\behavior_op_20250915'];

bea_path = [beh_video_path,'\BeA_path'];

sep_tpm_path = [rootpath,...
    '\raw_data\tpm_suite2p\sep'];

beh_neu_path = [rootpath,'\beh_neu_20250918'];
%% load data
fileFolder = fullfile(beh_neu_path);
dirOutput = dir(fullfile(fileFolder,'*-neu.mat'));
neuNames = {dirOutput.name}';
% neuNames([1,2,7,8],:) = [];
% neuNames([3,4,5,6,9,10],:) = [];

cut_size = 901;

all_data_cell = cell(size(neuNames,1),9);
%{rootname,neudata,pose_self,mov_self,seq_self,
% pose_partner,mov_partner,seq_partner, distance}

for k = 1:size(all_data_cell,1)
    rootname = neuNames{k}(1:(end-8));
    all_data_cell{k,1} = rootname;
    
    tempdata = load([beh_neu_path,'\',neuNames{k}]);
    all_data_cell{k,2} = tempdata.dff_smo_Fc(:,cut_size:end)';

    tempdata = load([beh_neu_path,'\',rootname,...
        '-pose-tpm.mat']);
    all_data_cell{k,3} = tempdata.coords3d(cut_size:end,:);

    tempdata = load([beh_neu_path,'\',rootname,...
        '-beh_mod-tpm.mat']);
    all_data_cell{k,4} = tempdata.beh_mod_list(cut_size:end,:);

    tempdata = load([beh_neu_path,'\',rootname,...
        '-seq-tpm.mat']);
    all_data_cell{k,5} = tempdata.seq_label_list(cut_size:end,:);

    tempdata = load([beh_neu_path,'\',rootname,...
        '-pose-free.mat']);
    all_data_cell{k,6} = tempdata.coords3d(cut_size:end,:);

    tempdata = load([beh_neu_path,'\',rootname,...
        '-beh_mod-free.mat']);
    all_data_cell{k,7} = tempdata.beh_mod_list(cut_size:end,:);

    tempdata = load([beh_neu_path,'\',rootname,...
        '-seq-free.mat']);
    all_data_cell{k,8} = tempdata.seq_label_list(cut_size:end,:);

    tempdata = load([beh_neu_path,'\',rootname,...
        '-distance-free.mat']);
    all_data_cell{k,9} = tempdata.dist_data;
    all_data_cell{k,9}{1,1} = ...
        all_data_cell{k,9}{1,1}(cut_size:end,:);
    all_data_cell{k,9}{1,2} = ...
        all_data_cell{k,9}{1,2}(cut_size:end,:);
    all_data_cell{k,9}{1,3} = ...
        all_data_cell{k,9}{1,3}(cut_size:end,:);
    disp(k)
end

%% load dynamic data
dy_name_list = {...
    'rec_op_low_social_20251009.mat';...
    'rec_op_high_social_20251009.mat';...
    'rec_low_social_20251009.mat';...
    'rec_high_social_20251009.mat';...
    };

dy_data_cell = cell(size(dy_name_list,1),1);
for k = 1:size(dy_data_cell,1)
    tempdata = load([beh_neu_path,'\',dy_name_list{k,1}]);
    dy_data_cell{k,1} = tempdata;
end
%% split far-close-far trial
fs = 30;
baseline_far_time = 5;%s,2
after_far_time = 2;%s,2
min_close_time = 2;%s
max_close_time = 4;%s

baseline_far_frame = baseline_far_time*fs;
after_far_frame = after_far_time*fs;
min_close_frame = min_close_time*fs;
max_close_frame = max_close_time*fs;

fcf_cell = {};

for k = 1:size(all_data_cell,1)
    %% load data
    tempdist = all_data_cell{k,9};
    
    %% select trials
    distsavelist = idx2savelist(tempdist{2});

    all_close_list = distsavelist(distsavelist(:,3)==1,:);

    all_close_list(all_close_list(:,1)<baseline_far_frame,:) = [];
    all_close_list(all_close_list(:,2)>...
        length(tempdist{2})-after_far_frame,:) = [];
    all_close_list(...
        (all_close_list(:,2)-all_close_list(:,1))<...
        min_close_frame,:) = [];
    all_close_list(...
        (all_close_list(:,2)-all_close_list(:,1))>...
        max_close_frame,:) = [];

    selidx = zeros(size(all_close_list,1),1);

    for m = 1:size(all_close_list,1)
        tempstart = all_close_list(m,1);
        tempend = all_close_list(m,2);
        seldata_baseline = tempdist{2}(...
            (tempstart-baseline_far_frame):(tempstart-1));
        seldata_after = tempdist{2}(...
            (tempend+1):(tempend+after_far_frame));

        if sum(seldata_baseline)==0 && sum(seldata_after)==0
            selidx(m,1) = 1;
        end
    end

    sel_close_list = all_close_list(selidx==1,:);
    %% append data
    for m = 1:size(sel_close_list,1)
        tempstart = sel_close_list(m,1)-baseline_far_frame;
        tempend = sel_close_list(m,2)+after_far_frame;

        newname = [all_data_cell{k,1},'-',num2str(m)];
        all_data_2 = all_data_cell{k,2}(tempstart:tempend,:);
        all_data_3 = all_data_cell{k,3}(tempstart:tempend,:);
        all_data_4 = all_data_cell{k,4}(tempstart:tempend,:);
        all_data_5 = all_data_cell{k,5}(tempstart:tempend,:);
        all_data_6 = all_data_cell{k,6}(tempstart:tempend,:);
        all_data_7 = all_data_cell{k,7}(tempstart:tempend,:);
        all_data_8 = all_data_cell{k,8}(tempstart:tempend,:);
        all_data_9 = all_data_cell{k,9}{3}(tempstart:tempend,:);

        fcf_cell = [fcf_cell;...
            {newname,all_data_2,all_data_3,all_data_4,...
            all_data_5,all_data_6,all_data_7,all_data_8,...
            all_data_9,all_data_cell{k,1}}];

        unique(all_data_5)
    end
    %%
    disp(k)
end
%% split free and op fcf
splname = split(fcf_cell(:,10),'-');
sel_free_idx = strcmp(splname(:,1),'free');
sel_op_idx = strcmp(splname(:,1),'op');

free_fcf_cell = fcf_cell(sel_free_idx,:);
op_fcf_cell = fcf_cell(sel_op_idx,:);

%% show mov and seq of all the trials
% sort data by length
free_fcf_length = cell2mat(cellfun(@(x) size(x,1),...
    free_fcf_cell(:,2),...
    'UniformOutput',false));

[~,sortidx] = sort(free_fcf_length,'descend');

free_sort_fcf_cell = free_fcf_cell(sortidx,:);

op_fcf_length = cell2mat(cellfun(@(x) size(x,1),...
    op_fcf_cell(:,2),...
    'UniformOutput',false));

[~,sortidx] = sort(op_fcf_length,'descend');

op_sort_fcf_cell = op_fcf_cell(sortidx,:);

%% create mov mat
pad_len = 240;

free_self_mov_mat = -1*ones(size(free_sort_fcf_cell,1),pad_len);
free_self_mov_start_list = zeros(size(free_self_mov_mat,1),2);
free_self_mov_end_list = zeros(size(free_self_mov_mat,1),2);

for k = 1:size(free_self_mov_mat,1)
    tempmov = cell2mat(free_sort_fcf_cell{k,4}(:,2))';
    free_self_mov_mat(k,1:length(tempmov)) = tempmov;
    free_self_mov_start_list(k,:) = [baseline_far_frame,k];
    free_self_mov_end_list(k,:) = [length(tempmov)-after_far_frame,k];
end

op_self_mov_mat = -1*ones(size(op_sort_fcf_cell,1),pad_len);
op_self_mov_start_list = zeros(size(op_self_mov_mat,1),2);
op_self_mov_end_list = zeros(size(op_self_mov_mat,1),2);

for k = 1:size(op_self_mov_mat,1)
    tempmov = cell2mat(op_sort_fcf_cell{k,4}(:,2))';
    op_self_mov_mat(k,1:length(tempmov)) = tempmov;
    op_self_mov_start_list(k,:) = [baseline_far_frame,k];
    op_self_mov_end_list(k,:) = [length(tempmov)-after_far_frame,k];
end

free_partner_mov_mat = -1*ones(size(free_sort_fcf_cell,1),pad_len);
free_partner_mov_start_list = zeros(size(free_partner_mov_mat,1),2);
free_partner_mov_end_list = zeros(size(free_partner_mov_mat,1),2);

for k = 1:size(free_partner_mov_mat,1)
    tempmov = cell2mat(free_sort_fcf_cell{k,7}(:,2))';
    free_partner_mov_mat(k,1:length(tempmov)) = tempmov;
    free_partner_mov_start_list(k,:) = [baseline_far_frame,k];
    free_partner_mov_end_list(k,:) = [length(tempmov)-after_far_frame,k];
end

op_partner_mov_mat = -1*ones(size(op_sort_fcf_cell,1),pad_len);
op_partner_mov_start_list = zeros(size(op_partner_mov_mat,1),2);
op_partner_mov_end_list = zeros(size(op_partner_mov_mat,1),2);

for k = 1:size(op_partner_mov_mat,1)
    tempmov = cell2mat(op_sort_fcf_cell{k,7}(:,2))';
    op_partner_mov_mat(k,1:length(tempmov)) = tempmov;
    op_partner_mov_start_list(k,:) = [baseline_far_frame,k];
    op_partner_mov_end_list(k,:) = [length(tempmov)-after_far_frame,k];
end


%% create seq mat
free_self_seq_mat = -1*ones(size(free_sort_fcf_cell,1),pad_len);
free_self_seq_start_list = zeros(size(free_self_seq_mat,1),2);
free_self_seq_end_list = zeros(size(free_self_seq_mat,1),2);

for k = 1:size(free_self_seq_mat,1)
    tempseq = free_sort_fcf_cell{k,5}';
    free_self_seq_mat(k,1:length(tempseq)) = tempseq;
    free_self_seq_start_list(k,:) = [baseline_far_frame,k];
    free_self_seq_end_list(k,:) = [length(tempseq)-after_far_frame,k];
end

op_self_seq_mat = -1*ones(size(op_sort_fcf_cell,1),pad_len);
op_self_seq_start_list = zeros(size(op_self_seq_mat,1),2);
op_self_seq_end_list = zeros(size(op_self_seq_mat,1),2);

for k = 1:size(op_self_seq_mat,1)
    tempseq = op_sort_fcf_cell{k,5}';
    op_self_seq_mat(k,1:length(tempseq)) = tempseq;
    op_self_seq_start_list(k,:) = [baseline_far_frame,k];
    op_self_seq_end_list(k,:) = [length(tempseq)-after_far_frame,k];
end

free_partner_seq_mat = -1*ones(size(free_sort_fcf_cell,1),pad_len);
free_partner_seq_start_list = zeros(size(free_partner_seq_mat,1),2);
free_partner_seq_end_list = zeros(size(free_partner_seq_mat,1),2);

for k = 1:size(free_partner_seq_mat,1)
    tempseq = free_sort_fcf_cell{k,8}';
    free_partner_seq_mat(k,1:length(tempseq)) = tempseq;
    free_partner_seq_start_list(k,:) = [baseline_far_frame,k];
    free_partner_seq_end_list(k,:) = [length(tempseq)-after_far_frame,k];
end

op_partner_seq_mat = -1*ones(size(op_sort_fcf_cell,1),pad_len);
op_partner_seq_start_list = zeros(size(op_partner_seq_mat,1),2);
op_partner_seq_end_list = zeros(size(op_partner_seq_mat,1),2);

for k = 1:size(op_partner_seq_mat,1)
    tempseq = op_sort_fcf_cell{k,8}';
    op_partner_seq_mat(k,1:length(tempseq)) = tempseq;
    op_partner_seq_start_list(k,:) = [baseline_far_frame,k];
    op_partner_seq_end_list(k,:) = [length(tempseq)-after_far_frame,k];
end
%% create neural activities
free_neu_mat = [];
free_neu_start_list = [];
free_neu_end_list = [];

count = 1;

for k = 1:size(free_sort_fcf_cell,1)
    tempneu = free_sort_fcf_cell{k,2}';
    padneu = nan(size(tempneu,1),pad_len);

    for m = 1:size(padneu,1)
        ttneu = tempneu(m,:);
        padneu(m,1:length(ttneu)) = ttneu;
        free_neu_start_list = [free_neu_start_list;[baseline_far_frame,count]];
        free_neu_end_list = [free_neu_end_list;[length(ttneu)-after_far_frame,count]];

        count = count+1;
    end
    
    free_neu_mat = [free_neu_mat;padneu];
end

op_neu_mat = [];
op_neu_start_list = [];
op_neu_end_list = [];

count = 1;

for k = 1:size(op_sort_fcf_cell,1)
    tempneu = op_sort_fcf_cell{k,2}';
    padneu = nan(size(tempneu,1),pad_len);

    for m = 1:size(padneu,1)
        ttneu = tempneu(m,:);
        padneu(m,1:length(ttneu)) = ttneu;
        op_neu_start_list = [op_neu_start_list;[baseline_far_frame,count]];
        op_neu_end_list = [op_neu_end_list;[length(ttneu)-after_far_frame,count]];

        count = count+1;
    end
    
    op_neu_mat = [op_neu_mat;padneu];
end

%% create lmt cell
free_lmt_cell = cell(size(free_sort_fcf_cell,1),1);
for k = 1:size(free_lmt_cell,1)
    %%
    tempneu = free_sort_fcf_cell{k,2};
    [coeff, score, ~, ~, explained] = pca(tempneu');

    norm_coeff = zeros(size(coeff));
    for m = 1:size(coeff,2)
        norm_coeff(:,m) = mat2gray(coeff(:,m));
    end

    free_lmt_cell{k,1} = norm_coeff;
    free_lmt_cell{k,2} = coeff;
    free_lmt_cell{k,3} = score;
    free_lmt_cell{k,4} = explained;
end

op_lmt_cell = cell(size(op_sort_fcf_cell,1),1);
for k = 1:size(op_lmt_cell,1)
    %%
    tempneu = op_sort_fcf_cell{k,2};
    [coeff, score, ~, ~, explained] = pca(tempneu');

    norm_coeff = zeros(size(coeff));
    for m = 1:size(coeff,2)
        norm_coeff(:,m) = mat2gray(coeff(:,m));
    end

    op_lmt_cell{k,1} = norm_coeff;
    op_lmt_cell{k,2} = coeff;
    op_lmt_cell{k,3} = score;
    op_lmt_cell{k,4} = explained;
end
%% create the unique_mov and unique_seq
all_mov = [];
all_mov_name = {};
for k = 1:size(fcf_cell,1)
    all_mov = [all_mov;...
        cell2mat(fcf_cell{k,4}(:,2));...
        cell2mat(fcf_cell{k,7}(:,2))];
    all_mov_name = [all_mov_name;...
        fcf_cell{k,4}(:,1);...
        fcf_cell{k,7}(:,1)];
end
unique_mov = unique(all_mov);
cmap_mov = cbrewer2('BuPu',length(unique_mov));

unique_mov_name = cell(size(unique_mov));
for k = 1:size(unique_mov,1)
    tempname = all_mov_name(unique_mov(k)==all_mov);
    unique_mov_name{k} = tempname{1};
end

all_seq = [];
for k = 1:size(fcf_cell,1)
    all_seq = [all_seq;fcf_cell{k,5};fcf_cell{k,8}];
end
unique_seq = unique(all_seq);
unique_seq = unique_seq(2:end);
cmap_seq = cbrewer2('BuPu',length(unique_seq));
%% plot canvas
hall = figure(1);
set(hall,'Position',[980,100,800,800])
set(hall,'color','white');
%% show paradigm, top op, bottom raw
start_x = 0.06;
start_y = 0.89;

box_x = 0.1;
box_y = 0.08;

inter_y = 0.02;

subplot('Position',[...
    start_x,start_y,box_x,box_y])
x = 0:0.1:20;
a = 1;
b = -1*(10*2*a);
y = a.*x.*x+b.*x;
plot(x,y,'-k')
ylabel({'dmPFC recording',...
    '+ Opto-activation',...
    'Distance'})

title('Experiments')

box off
set(gca,'XTick',[],'YTick',[])
set(gca,'FontSize',6)

subplot('Position',[...
    start_x,start_y-(box_y+inter_y),box_x,box_y])
x = 0:0.1:20;
a = 1;
b = -1*(10*2*a);
y = a.*x.*x+b.*x;
plot(x,y,'-k')
xlabel('Time')
ylabel({'dmPFC recording',...
    'Distance'})

box off
set(gca,'XTick',[],'YTick',[])
set(gca,'FontSize',6)
%% show self mov, top op, bottom raw 
start_x = 0.2;
start_y = 0.89;

box_x = 0.075;
box_y = 0.08;

inter_y = 0.02;

x_tick = [1,60,120,180,240];
x_tick_label = [-2,0,2,4,6];

temph = subplot('Position',[start_x,start_y,box_x,box_y]);
imagesc(op_self_mov_mat)
colormap(temph,[1,1,1;cmap_mov])
hold on
plot(op_self_mov_start_list(:,1),op_self_mov_start_list(:,2),'-k')
hold on
plot(op_self_mov_end_list(:,1),op_self_mov_end_list(:,2),'-k')
hold off

box off
title('Subject')

ylabel('Movement trials')

set(gca,'XTick',x_tick)
set(gca,'XTickLabel',[])
% set(gca,'XTickLabel',x_tick_label)

set(gca,'YTick',[1,size(op_self_mov_mat,1)])

set(gca,'TickDir','out')
set(gca,'FontSize',6)

temph = subplot('Position',[...
    start_x,start_y-(box_y+inter_y),box_x,box_y]);
imagesc(free_self_mov_mat)
colormap(temph,[1,1,1;cmap_mov])
hold on
plot(free_self_mov_start_list(:,1),free_self_mov_start_list(:,2),'-k')
hold on
plot(free_self_mov_end_list(:,1),free_self_mov_end_list(:,2),'-k')
hold off

box off

ylabel('Movement trials')

set(gca,'XTick',x_tick)
% set(gca,'XTickLabel',[])
set(gca,'XTickLabel',x_tick_label)

set(gca,'YTick',[1,size(free_self_mov_mat,1)])

set(gca,'TickDir','out')
set(gca,'FontSize',6)
xlabel('Time (s)')

%% show partner mov, top op, bottom raw 
start_x = 0.29;
start_y = 0.89;

box_x = 0.075;
box_y = 0.08;

inter_y = 0.02;

temph = subplot('Position',[start_x,start_y,box_x,box_y]);
imagesc(op_partner_mov_mat)
colormap(temph,[1,1,1;cmap_mov])
hold on
plot(op_partner_mov_start_list(:,1),op_partner_mov_start_list(:,2),'-k')
