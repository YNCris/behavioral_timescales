ylabel({'Non-locomotion','speed (cm/s)'})

axis([0.3,16.7,0,8])

set(gca,'FontSize',6)
set(gca,'TickDir','out')
box off

set(gca,'XTick',x_list)
set(gca,'XTickLabel',body_point_name)
%% dynamic analysis
start_x = 0.04;
start_y = 0.32;

box_x = 0.14;
box_y = box_x;

inter_x = 0.012;

quv_cmap_list = [free_c;op_c];

nxpts = 15;
nypts = 15;

dy_title_list = {...
    'PC 1-10, Rec + Opto';...
    'PC 16-25, Rec + Opto';...
    'PC 1-10, Rec';...
    'PC 16-25, Rec';...
    };

curve_cmap = flipud(cbrewer2('Spectral',256));

c_mk_size = 0.5;

% op low
sel_dy_idx = 1;
subplot('Position',[...
    start_x,start_y,box_x,box_y])
% load variables
z_dist = dy_data_cell{sel_dy_idx}.z_dist;
z_dist_savelist = idx2savelist(z_dist);

sel_0_savelist = z_dist_savelist(...
    z_dist_savelist(:,3)==0,:);
sel_0_savelist([1,end],:) = [];
cut_pos = (sel_0_savelist(:,1)+sel_0_savelist(:,2))/2;

start_pos = [1;(cut_pos+1)];
end_pos = [cut_pos;z_dist_savelist(end,2)];

savelist = [start_pos,end_pos];

x_cell = cell(size(savelist,1),2);
xhat_dist_lem = dy_data_cell{sel_dy_idx}.xhat_dist_lem;
for k = 1:size(x_cell,1)
    tempx = xhat_dist_lem(...
        savelist(k,1):savelist(k,2),:)';
    x_cell{k,1} = tempx;

    tempdist = double(z_dist(...
        savelist(k,1):savelist(k,2),:)');
    x_cell{k,2} = tempdist;
end
% 生成网格点
lim = max(dy_data_cell{sel_dy_idx}.xhat_dist_lem) + 1;

xlim_range = [-1*lim(1),lim(1)];
ylim_range = [-1*lim(2),lim(2)];

x = linspace(xlim_range(1), xlim_range(2), nxpts);
y = linspace(ylim_range(1), ylim_range(2), nypts);
[X, Y] = meshgrid(x, y);

% 组合网格点
xy = [X(:), Y(:)];

% 计算每个 (x, y) 位置的每个状态的概率，并找到最大概率对应的状态
z = zeros(size(xy, 1), 1); % 初始化 z，用于存储每个点的状态

for i = 1:size(xy, 1)
    % 对每个点计算状态得分
    scores = xy(i, :) * ...
        dy_data_cell{sel_dy_idx}.model_transitions_s_T' + ...
        dy_data_cell{sel_dy_idx}.model_transitions_r;
    % 找到得分最高的状态索引
    [~, z(i)] = max(scores);
end

% 遍历每个动态系统的参数 (A, b)
for k = 1:length(dy_data_cell{sel_dy_idx}.model_dynamics_As)
    A = reshape(dy_data_cell{sel_dy_idx}.model_dynamics_As(k,:,:),2,2)';
    b = dy_data_cell{sel_dy_idx}.model_dynamics_bs(k,:);
    
    % 计算每个 (x, y) 的 dx/dt 和 dy/dt
    dxydt_m = xy * A + ones(size(xy,1),1)*b - xy;

    % 找到属于状态 k 的点
    zk = (z == k);

    % 如果状态 k 中有点
    if sum(zk) > 0
        % 绘制速度场矢量
        quiver(xy(zk, 1), xy(zk, 2), ...
               dxydt_m(zk, 1), dxydt_m(zk, 2),...
               'Color',quv_cmap_list(k,:));
        hold on
    end
end
hold on

XL = get(gca,'xlim'); XR = XL(2);
YL = get(gca,'ylim'); YT = YL(2);

plot(XL,YT*ones(size(XL)),...
    'color', 'k','linewidth',0.25)
hold on
plot(XR*ones(size(YL)),YL,...
    'color', 'k','linewidth',0.25)
hold on

