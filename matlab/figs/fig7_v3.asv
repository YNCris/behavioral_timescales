    [p,h] = signrank(opdata,freedata);
    disp('signrank')
    disp(p)
end
p_list_high = p;

opdata = group_low(:,1);
freedata = group_low(:,2);

[h_norm_1,p_norm_1] = lillietest(opdata);
[h_norm_2,p_norm_2] = lillietest(freedata);

[h_var,p_var] = vartest2(opdata,freedata);

sum_h = h_norm_1+h_norm_2+h_var;

if sum_h==0
    [h,p] = ttest(opdata,freedata);
    disp('ttest')
    disp(p)
else
    [p,h] = signrank(opdata,freedata);
    disp('signrank')
    disp(p)
end
p_list_low = p;

H_op_high_s = H_op_high;
H_free_high_s = H_free_high;
H_op_low_s = H_op_low;
H_free_low_s = H_free_low;

group_high_s = group_high;
group_low_s = group_low;
p_list_high_s = p_list_high;
p_list_low_s = p_list_low;

%% show quantification
start_x = 0.67;
start_y = 0.31;

box_x = 0.08;
box_y = 0.14;

inter_x = 0.04;
inter_y = 0.01;

show_cell = {...
    H_op_high_r,H_free_high_r,...
    H_op_low_r,H_free_low_r,...
    group_high_r,group_low_r,...
    p_list_high_r,p_list_low_r;...
    H_op_high_r_cv,H_free_high_r_cv,...
    H_op_low_r_cv,H_free_low_r_cv,...
    group_high_r_cv,group_low_r_cv,...
    p_list_high_r_cv,p_list_low_r_cv;...
    H_op_high_s,H_free_high_s,...
    H_op_low_s,H_free_low_s,...
    group_high_s,group_low_s,...
    p_list_high_s,p_list_low_s;...
    };

show_x_list = [1,2,3.5,4.5];

show_x_tick_list = [...
    mean(show_x_list(1:2)),...
    mean(show_x_list(3:4))];

bar_w = 0.6;

cap_size = 2;

mk_size = 2;

x_bias = bar_w/2;

bar_c_mat = [...
    op_c;...
    free_c;...
    op_c;...
    free_c;...
    ];

ylabel_list = {...
    'Radius';...
    'Relative radial variability';...
    'Angular sweep score'};

show_x_tick = {...
    'PC 1-5';...
    'PC 20-25'};

show_star_y_pos = [...
    0,0.3;...
    0,0.7;...
    0,0];


for k = 1:size(show_cell,1)
    % bar
    temp_group_low = show_cell{k,6};
    temp_group_high = show_cell{k,5};
    temp_low_p = show_cell{k,8};
    temp_high_p = show_cell{k,7};

    % calculate star
    tempp = temp_low_p;
    for m = 1:size(show_star_list,1)
        if show_star_list{m,1}<=tempp &&...
                tempp<show_star_list{m,2}
            show_star_y_low = show_star_list{m,3};
            continue
        elseif tempp==1
            show_star_y_low = 'ns';
        end
    end

    tempp = temp_high_p;
    for m = 1:size(show_star_list,1)
        if show_star_list{m,1}<=tempp &&...
                tempp<show_star_list{m,2}
            show_star_y_high = show_star_list{m,3};
            continue
        elseif tempp==1
            show_star_y_high = 'ns';
        end
    end

    show_bar = [temp_group_low,temp_group_high];

    mean_bar = mean(show_bar);
    std_bar = std(show_bar)./sqrt(size(show_bar,1));

    subplot('Position',[...
        start_x+(k-1)*(box_x+inter_x),...
        start_y,...
        box_x,box_y])
    for m = 1:size(show_bar,2)
        bar(show_x_list(m),mean_bar(m),bar_w,...
            'FaceColor',bar_c_mat(m,:))
        hold on
        errorbar(show_x_list(m),mean_bar(m),...
            std_bar(m),...
            'LineStyle','none',...
            'CapSize',cap_size,...
            'Color','k')
        hold on
    end

    for m = 1:size(show_bar,1)
        plot(x_bias+show_x_list(1:2),...
            show_bar(m,1:2),'-k')
        hold on
        plot(x_bias+show_x_list(3:4),...
            show_bar(m,3:4),'-k')
        hold on
        plot(x_bias+show_x_list(1:2),...
            show_bar(m,1:2),'o',...
            'MarkerFaceColor','w',...
            'MarkerEdgeColor','k',...
            'LineWidth',0.25,...
            'MarkerSize',mk_size)
        hold on
        plot(x_bias+show_x_list(3:4),...
            show_bar(m,3:4),'o',...
            'MarkerFaceColor','w',...
            'MarkerEdgeColor','k',...
            'LineWidth',0.25,...
            'MarkerSize',mk_size)
        hold on
    end

    show_sign = {show_star_y_low,show_star_y_high};
    temp_y_pos = show_star_y_pos(k,:);

    for m = 1:size(show_sign,2)
        if m == 1
            show_x_pos = show_x_list(1:2);
        else
            show_x_pos = show_x_list(3:4);
        end

        if ~strcmp(show_sign{m},'ns')
            plot(show_x_pos,...
                [temp_y_pos(m),temp_y_pos(m)],...
                '-k')
            hold on
            text()
        end
    end

    hold off

    set(gca,'FontSize',6)
    box off

    set(gca,'TickDir','out')

    set(gca,'XTick',show_x_tick_list)

    set(gca,'XTickLabel',show_x_tick)

    ylabel(ylabel_list{k})
end

















