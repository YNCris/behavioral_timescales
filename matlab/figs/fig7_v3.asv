%% mesostasis analysis comparison, r
H_op_high = cellfun(@(x) ...
    traj_radius_stats_2D_r(x),...
    x_cell_op_high(:,1));
H_free_high = cellfun(@(x) ...
    traj_radius_stats_2D_r(x),...
    x_cell_free_high(:,1));

ranksum(H_op_high,H_free_high)

H_op_low = cellfun(@(x) ...
    traj_radius_stats_2D_r(x),...
    x_cell_op_low(:,1));
H_free_low = cellfun(@(x) ...
    traj_radius_stats_2D_r(x),...
    x_cell_free_low(:,1));

ranksum(H_op_low,H_free_low)

% split names
match_brain_name = {...
    '6tpmpfc';...
    '7tpmpfc';...
    '8tpmpfc';...
    '9tpmpfc';...
    '10tpmpfc';...
    };

brain_name_op_high = split_op_name(name_op_high);
brain_name_free_high = split_op_name(name_free_high);
brain_name_op_low = split_op_name(name_op_low);
brain_name_free_low = split_op_name(name_free_low);

group_high = zeros(size(match_brain_name,1),2);%[op,free]
group_low = zeros(size(match_brain_name,1),2);%[op,free]

for k = 1:size(match_brain_name,1)
    tempbrainname = match_brain_name{k,1};

    % op high
    selidx = strcmp(tempbrainname,brain_name_op_high);
    seldata = H_op_high(selidx);
    group_high(k,1) = mean(seldata);

    % free high
    selidx = strcmp(tempbrainname,brain_name_free_high);
    seldata = H_free_high(selidx);
    group_high(k,2) = mean(seldata);

    % op low
    selidx = strcmp(tempbrainname,brain_name_op_low);
    seldata = H_op_low(selidx);
    group_low(k,1) = mean(seldata);

    % free low
    selidx = strcmp(tempbrainname,brain_name_free_low);
    seldata = H_free_low(selidx);
    group_low(k,2) = mean(seldata);
end

opdata = group_high(:,1);
freedata = group_high(:,2);

[h_norm_1,p_norm_1] = lillietest(opdata);
[h_norm_2,p_norm_2] = lillietest(freedata);

[h_var,p_var] = vartest2(opdata,freedata);

sum_h = h_norm_1+h_norm_2+h_var;

if sum_h==0
    [h,p] = ttest(opdata,freedata);
    disp('ttest')
    disp(p)
else
    [p,h] = signrank(opdata,freedata);
    disp('signrank')
    disp(p)
end
p_list_high = p;

opdata = group_low(:,1);
freedata = group_low(:,2);

[h_norm_1,p_norm_1] = lillietest(opdata);
[h_norm_2,p_norm_2] = lillietest(freedata);

[h_var,p_var] = vartest2(opdata,freedata);

sum_h = h_norm_1+h_norm_2+h_var;

if sum_h==0
    [h,p] = ttest(opdata,freedata);
    disp('ttest')
    disp(p)
else
    [p,h] = signrank(opdata,freedata);
    disp('signrank')
    disp(p)
end
p_list_low = p;

H_op_high_r = H_op_high;
H_free_high_r = H_free_high;
H_op_low_r = H_op_low;
H_free_low_r = H_free_low;

group_high_r = group_high;
group_low_r = group_low;
p_list_high_r = p_list_high;
p_list_low_r = p_list_low;

