%% calculate predictability, dim normalization
lin_list = 0.05:0.05:1;
gama_range = 9;
resample_list = (1-(1-lin_list).^gama_range)*100;
% figure
% plot(resample_list)

bd_up = 0.25;
bd_down = 0.8;
nbins = 20;

ttpc_thres = 100;

op_trajc_cell = cell(size(op_lmt_cell,1),3);

for k = 1:size(op_trajc_cell,1)
    temppc = op_lmt_cell{k,1};
    tempfftmat = zeros(1,size(temppc,2));
    for m = 1:size(temppc,2)
        % tempfft = traj_fft(temppc(:,m));
        % tempfft = traj_complexity_fft(temppc(:,m),bd_up,bd_down);
        %tempfft = temporal_entropy(temppc(:,m), nbins);
        % tempfft = var(temppc(:,m));
        % ttpc = temppc(:,m);
        % ttpcdist = [0;diff(ttpc)];
        % ttpc_v = sqrt(ttpcdist.^2);
        % tempfft = mean(ttpc_v(ttpc_v<ttpc_thres));
        % tempfft = clean_psd_mean(temppc(:,m));
        % tempfft = estimate_pc_noise(temppc(:,m));
        % tempfft = dyn_noise_estimate(temppc(:,m));
        tempfft = pc_predictability_metrics(temppc(:,m));
        tempfftmat(1,m) = tempfft;
    end
    % plot(tempfftmat)
    % title(k)
    % pause
    op_trajc_cell{k,1} = tempfftmat;

    temp_lmd = op_lmt_cell{k,4};
    cumsum_lmd = cumsum(temp_lmd);
    op_trajc_cell{k,2} = cumsum_lmd;

    selpcidx = zeros(size(resample_list));
    for m = 1:length(resample_list)
        tempdist = abs(resample_list(m)-cumsum_lmd);
        tempidx = find(tempdist==min(tempdist));
        selpcidx(m) = tempidx(1);
    end

    op_trajc_cell{k,3} = selpcidx;


end

free_trajc_cell = cell(size(free_lmt_cell,1),3);

for k = 1:size(free_trajc_cell,1)
    temppc = free_lmt_cell{k,1};
    tempfftmat = zeros(1,size(temppc,2));
    for m = 1:size(temppc,2)
        % tempfft = traj_fft(temppc(:,m));
        % tempfft = traj_complexity_fft(temppc(:,m),bd_up,bd_down);
        %tempfft = temporal_entropy(temppc(:,m), nbins);
        % tempfft = var(temppc(:,m));
        % ttpc = temppc(:,m);
        % ttpcdist = [0;diff(ttpc)];
        % ttpc_v = sqrt(ttpcdist.^2);
        % tempfft = mean(ttpc_v(ttpc_v<ttpc_thres));
        % tempfft = clean_psd_mean(temppc(:,m));
        % tempfft = estimate_pc_noise(temppc(:,m));
        % tempfft = dyn_noise_estimate(temppc(:,m));
        tempfft = pc_predictability_metrics(temppc(:,m));
        tempfftmat(1,m) = tempfft;
    end
    % plot(tempfftmat)
    % title(k)
    % pause
    free_trajc_cell{k,1} = tempfftmat;

    temp_lmd = free_lmt_cell{k,4};
    cumsum_lmd = cumsum(temp_lmd);
    free_trajc_cell{k,2} = cumsum_lmd;
    
    selpcidx = zeros(size(resample_list));
    for m = 1:length(resample_list)
        tempdist = abs(resample_list(m)-cumsum_lmd);
        tempidx = find(tempdist==min(tempdist));
        selpcidx(m) = tempidx(1);
    end

    free_trajc_cell{k,3} = selpcidx;
end

% %% temp show
% cmp_pair_name = {...
%     '6tpmpfc';...
%     '7tpmpfc';...
%     '8tpmpfc';...
%     '9tpmpfc';...
%     '10tpmpfc';...
%     };
% 
% op_splname = split(op_sort_fcf_cell(:,1),'-');
% free_splname = split(free_sort_fcf_cell(:,1),'-');
% 
% var_cmp_op_data = cell(size(cmp_pair_name,1),...
%     1);
% var_cmp_free_data = cell(size(cmp_pair_name,1),...
%     1);
% 
% for k = 1:size(cmp_pair_name,1)
%     selopidx = strcmp(cmp_pair_name{k},op_splname(:,3));
%     selfreeidx = strcmp(cmp_pair_name{k},free_splname(:,3));
% 
%     var_cmp_op_data(k,:) = mean(normdim_op_trajc(selopidx,:));
%     var_cmp_free_data(k,:) = mean(normdim_free_trajc(selopidx,:));
% end

%
%
sel_len = length(resample_list);
normdim_op_trajc = cell2mat(cellfun(@(x,y)...
    x(y),...
    op_trajc_cell(:,1),...
    op_trajc_cell(:,3),...
    'UniformOutput',false));

normdim_free_trajc = cell2mat(cellfun(@(x,y)...
    x(y),...
    free_trajc_cell(:,1),...
    free_trajc_cell(:,3),...
    'UniformOutput',false));

cmp_pair_name = {...
    '6tpmpfc';...
    '7tpmpfc';...
    '8tpmpfc';...
    '9tpmpfc';...
    '10tpmpfc';...
    };

op_splname = split(op_sort_fcf_cell(:,1),'-');
free_splname = split(free_sort_fcf_cell(:,1),'-');

trajc_cmp_op_data = zeros(size(cmp_pair_name,1),...
    sel_len);
trajc_cmp_free_data = zeros(size(cmp_pair_name,1),...
    sel_len);

for k = 1:size(cmp_pair_name,1)
    selopidx = strcmp(cmp_pair_name{k},op_splname(:,3));
    selfreeidx = strcmp(cmp_pair_name{k},free_splname(:,3));

    trajc_cmp_op_data(k,:) = mean(normdim_op_trajc(selopidx,:))*100;
    trajc_cmp_free_data(k,:) = mean(normdim_free_trajc(selfreeidx,:))*100;
end

stat_trajc_cmp_op_data = trajc_cmp_op_data;
stat_trajc_cmp_free_data = trajc_cmp_free_data;

% p values
% paired test
p_list = zeros(1,size(stat_trajc_cmp_op_data,2));
for k = 1:size(p_list,2)
    disp(k)
    opdata = stat_trajc_cmp_op_data(:,k);
    freedata = stat_trajc_cmp_free_data(:,k);
    
    [h_norm_1,p_norm_1] = lillietest(opdata);
    [h_norm_2,p_norm_2] = lillietest(freedata);

    [h_var,p_var] = vartest2(opdata,freedata);

    sum_h = h_norm_1+h_norm_2+h_var;

    if sum_h==0
        [h,p] = ttest(opdata,freedata);
        disp('ttest')
        disp(p)
    else
        [p,h] = signrank(opdata,freedata);
        disp('signrank')
        disp(p)
    end
    disp(p)
    p_list(1,k) = p;
end

show_p = p_list(1,:);
show_star_y_list = cell(size(show_p));
for k = 1:length(show_p)
    tempp = show_p(k);
    for m = 1:size(show_star_list,1)
        if show_star_list{m,1}<=tempp &&...
                tempp<show_star_list{m,2}
            show_star_y_list{k} = show_star_list{m,3};
            continue
        elseif tempp==1
            show_star_y_list{k} = 'ns';
        end
    end
end

% show pls
% neu: cause, beh: effects，diff dim PCs
% varibles:
% trial data:
% normdim_op_trajc,  trial_op_speed_subject
% normdim_free_trajc,  trial_free_speed_subject
%
% individual data:
% trajc_cmp_op_data,  trial_op_subject_group_data
% trajc_cmp_free_data,  trial_free_subject_group_data

trial_op_speed_subject = mean(op_speed_subject,2);
trial_free_speed_subject = mean(free_speed_subject,2);

trial_op_subject_group_data = mean(op_subject_group_data,2);
trial_free_subject_group_data = mean(free_subject_group_data,2);

diff_pose = trial_op_subject_group_data-...
    trial_free_subject_group_data;

diff_pc = trajc_cmp_op_data-trajc_cmp_free_data;

cos_list_diff = zeros(size(diff_pc,2),1);
for k = 1:size(cos_list_diff,1)
    temp_diff_pc = diff_pc(:,k);
    tempcos = (diff_pose'*temp_diff_pc)/...
        (norm(diff_pose)*norm(temp_diff_pc));
    cos_list_diff(k) = tempcos;
    disp([k,tempcos])
end

cos_list_op = zeros(size(trajc_cmp_op_data,2),1);
for k = 1:size(cos_list_op,1)
    temp_diff_pc = trajc_cmp_op_data(:,k);
    tempcos = (trial_op_subject_group_data'*temp_diff_pc)/...
        (norm(trial_op_subject_group_data)*norm(temp_diff_pc));
    cos_list_op(k) = tempcos;
    disp([k,tempcos])
end

cos_list_free = zeros(size(trajc_cmp_free_data,2),1);
for k = 1:size(cos_list_free,1)
    temp_diff_pc = trajc_cmp_free_data(:,k);
    tempcos = (trial_free_subject_group_data'*temp_diff_pc)/...
        (norm(trial_free_subject_group_data)*norm(temp_diff_pc));
    cos_list_free(k) = tempcos;
    disp([k,tempcos])
end

% correlation between pc predictability and NL speed
pred_B = trajc_cmp_op_data;
pred_A = trajc_cmp_free_data;
speed_B = trial_op_subject_group_data;
speed_A = trial_free_subject_group_data;

N_mouse = size(pred_A,1);
N_PC = size(pred_A,2);

delta_pred = pred_B - pred_A;   % [mouse x PC]
delta_speed = speed_B - speed_A; % [mouse x 1]

%% 系统级 predictability 变化强度（每只鼠一个数）,二项符号检验
p_dir = nan(N_PC,1);
k_match = nan(N_PC,1);
n_valid = nan(N_PC,1);

sign_mat = zeros(N_mouse,N_PC);

epsP = 1e-6;
epsS = 1e-6;

for k = 1:N_PC
    DeltaP = delta_pred(:,k);
    DeltaS = delta_speed(:);

    % 有效鼠（排除接近0的）
    valid = (abs(DeltaP) > epsP) & (abs(DeltaS) > epsS);

    % 反向一致（你当前的机制）
    k_obs = sum(sign(DeltaP(valid)) == -sign(DeltaS(valid)));

    % exact binomial (one-sided)
    p = binocdf(k_obs-1, N_mouse, 0.5, 'upper');

    p_dir(k)   = p;
    k_match(k) = k_obs;
    n_valid(k)= N_mouse;

    sign_mat(:,k) = sign(DeltaP(valid)) == -sign(DeltaS(valid));
end

p_dir = p_dir';
show_p = p_dir(1,:);
show_star_y_list_dir = cell(size(show_p));
for k = 1:length(show_p)
    tempp = show_p(k);
    for m = 1:size(show_star_list,1)
        if show_star_list{m,1}<=tempp &&...
                tempp<show_star_list{m,2}
            show_star_y_list_dir{k} = show_star_list{m,3};
            continue
        elseif tempp==1
            show_star_y_list_dir{k} = 'ns';
        end
    end
end
